# Copy this file to .env and fill in real values.
# The real .env file must NEVER be committed (see .gitignore).

# "development" or "production"
MATRIX_MODE=development

# Connection string for data storage
DATABASE_URL=postgresql://neo:redpill@localhost:5432/zion

# Secret key for external services
API_KEY=replace-me-with-a-real-secret

# Logging verbosity (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=DEBUG

# URL for the resistance network
ZION_ENDPOINT=https://mainframe.zion.io
